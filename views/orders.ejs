<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <title>My Orders</title>
</head>
<body class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>📦 Your Orders</h3>
        <a href="/" class="btn btn-outline-dark btn-sm">Back to Store</a>
    </div>
    
    <% if(orders.length === 0) { %>
        <div class="alert alert-light border">No orders placed yet.</div>
    <% } %>

    <% orders.forEach(o => { %>
        <div class="card mb-3 shadow-sm border-start border-primary border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-primary mb-1 text-uppercase small fw-bold">Order #<%= o.id %></h6>
                    <p class="mb-0"><strong>Items:</strong> <%= o.items %></p>
                </div>
                <div class="text-end">
                    <span class="badge bg-success mb-1 d-block"><%= o.status %></span>
                    <span class="fw-bold">$<%= o.total_price %></span>
                </div>
            </div>
        </div>
    <% }) %>
</body>
</html>