<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <title>Admin Dashboard</title>
</head>
<body class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="text-danger">Admin Control Center</h2>
        <a href="/" class="btn btn-dark btn-sm">Go to Homepage</a>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card p-3 shadow-sm bg-light">
                <h5>Add New Product</h5>
                <form action="/admin/add-product" method="POST" class="mt-3">
                    <input type="text" name="name" placeholder="Product Name" class="form-control mb-2" required>
                    <input type="number" step="0.01" name="price" placeholder="Price ($)" class="form-control mb-2" required>
                    <textarea name="description" placeholder="Description" class="form-control mb-2"></textarea>
                    <input type="url" name="image_url" placeholder="Image URL (Direct link)" class="form-control mb-3">
                    <button class="btn btn-danger w-100">Add Product</button>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <h5>Customer Orders Logs</h5>
            <table class="table table-hover table-bordered mt-3 small">
                <thead class="table-dark">
                    <tr><th>ID</th><th>User</th><th>Products</th><th>Total</th><th>Status</th></tr>
                </thead>
                <tbody>
                    <% orders.forEach(ord => { %>
                        <tr>
                            <td>#<%= ord.id %></td>
                            <td><%= ord.username %></td>
                            <td><%= ord.items %></td>
                            <td>$<%= ord.total_price %></td>
                            <td><span class="badge bg-secondary"><%= ord.status %></span></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>