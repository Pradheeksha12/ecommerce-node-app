<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <title>Store</title>
</head>
<body class="container py-4">
    <div class="d-flex justify-content-between mb-4">
        <h2>🏪 Our Store</h2>
        <div>
            <% if (user) { %>
                <span>Hi, <%= user.username %></span>
                <a href="/orders" class="btn btn-info btn-sm">Orders</a>
                <% if(user.role === 'admin') { %> <a href="/admin" class="btn btn-danger btn-sm">Admin</a> <% } %>
                <a href="/logout" class="btn btn-secondary btn-sm">Logout</a>
            <% } else { %>
                <a href="/login" class="btn btn-primary">Login</a>
            <% } %>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8">
            <div class="row">
                <% products.forEach(p => { %>
                    <div class="col-md-6 mb-3">
                        <div class="card shadow-sm">
                            <img src="<%= p.image_url %>" class="card-img-top" style="height:150px; object-fit:cover;">
                            <div class="card-body">
                                <h5><%= p.name %></h5>
                                <p>$<%= p.price %></p>
                                <form action="/add-to-cart" method="POST">
                                    <input type="hidden" name="productId" value="<%= p.id %>">
                                    <input type="hidden" name="name" value="<%= p.name %>">
                                    <input type="hidden" name="price" value="<%= p.price %>">
                                    <button class="btn btn-success btn-sm w-100">Add to Cart</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3">
                <h4>🛒 Cart</h4>
                <ul class="list-group">
                    <% cart.forEach(c => { %>
                        <li class="list-group-item d-flex justify-content-between"><%= c.name %> <span>$<%= c.price %></span></li>
                    <% }) %>
                </ul>
                <form action="/checkout" method="POST" class="mt-3">
                    <button class="btn btn-warning w-100" <%= cart.length === 0 ? 'disabled' : '' %>>Checkout</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>